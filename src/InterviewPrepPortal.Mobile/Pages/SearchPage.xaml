<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InterviewPrepPortal.Mobile.Pages.SearchPage"
             Title="Search">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="10">

        <SearchBar Grid.Row="0" Placeholder="Search all questions"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}" />

        <HorizontalStackLayout Grid.Row="1" Spacing="8">
            <Button Text="All" Command="{Binding SetScopeCommand}" CommandParameter="All" />
            <Button Text="Category" Command="{Binding SetScopeCommand}" CommandParameter="Category" />
            <Button Text="Project" Command="{Binding SetScopeCommand}" CommandParameter="Project" />
        </HorizontalStackLayout>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}" Margin="0,6"
                           BorderColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuestionTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding QuestionText}" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Source}" Style="{StaticResource SubtleLabel}" />
                                <Label Text="{Binding Difficulty}" Style="{StaticResource SubtleLabel}" />
                                <Label Text="{Binding Frequency}" Style="{StaticResource SubtleLabel}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>
