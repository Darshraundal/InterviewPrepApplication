<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InterviewPrepPortal.Mobile.Pages.ProjectsPage"
             Title="Projects">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <CollectionView ItemsSource="{Binding Projects}" Margin="16">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Style="{StaticResource CardFrame}" Margin="0,6">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProjectTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource SubtleLabel}" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Difficulty}" Style="{StaticResource SubtleLabel}" />
                                <Label Text="{Binding StackSummary}" Style="{StaticResource SubtleLabel}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
