<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InterviewPrepPortal.Mobile.Pages.CategoryDetailPage"
             Title="{Binding Category.Name}">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="10">

        <SearchBar Grid.Row="0" Placeholder="Search this category"
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding LoadCommand}" />

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Questions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}" Margin="0,6"
                               BorderColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnQuestionTapped" />
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding Number}" Style="{StaticResource SubtleLabel}" VerticalOptions="Start" />
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding QuestionText}" FontAttributes="Bold" />
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding Frequency}" Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding Difficulty}" Style="{StaticResource SubtleLabel}" />
                                        <Label Text="{Binding StatusGlyph}" Style="{StaticResource SubtleLabel}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="{Binding FavoriteGlyph}" FontSize="20" VerticalOptions="Start">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFavoriteTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
