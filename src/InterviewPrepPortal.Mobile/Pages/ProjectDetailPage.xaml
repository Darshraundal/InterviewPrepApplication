<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InterviewPrepPortal.Mobile.Pages.ProjectDetailPage"
             Title="{Binding Project.Name}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Label Text="{Binding Project.Subtitle}" Style="{StaticResource SubtleLabel}" />
                <Label Text="{Binding Project.Description}" />

                <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding Detail.ArchitectureSummary, Converter={StaticResource ObjectNotNullConverter}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Architecture" FontAttributes="Bold" />
                        <Label Text="{Binding Detail.ArchitectureSummary.Overview}" />
                        <Label Text="{Binding Detail.ArchitectureSummary.RequestLifecycle}"
                               IsVisible="{Binding Detail.ArchitectureSummary.RequestLifecycle, Converter={StaticResource StringNotEmptyConverter}}" />
                        <Label Text="{Binding Detail.ArchitectureSummary.AuthFlow}"
                               IsVisible="{Binding Detail.ArchitectureSummary.AuthFlow, Converter={StaticResource StringNotEmptyConverter}}" />
                        <Label Text="{Binding Detail.ArchitectureSummary.DatabaseFlow}"
                               IsVisible="{Binding Detail.ArchitectureSummary.DatabaseFlow, Converter={StaticResource StringNotEmptyConverter}}" />
                    </VerticalStackLayout>
                </Frame>

                <SearchBar Placeholder="Search this project"
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding FilterChangedCommand}" />

                <Picker ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" />

                <CollectionView ItemsSource="{Binding Questions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardFrame}" Margin="0,6"
                                   BorderColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuestionTapped" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Number}" Style="{StaticResource SubtleLabel}" VerticalOptions="Start" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding QuestionText}" FontAttributes="Bold" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Frequency}" Style="{StaticResource SubtleLabel}" />
                                            <Label Text="{Binding Difficulty}" Style="{StaticResource SubtleLabel}" />
                                            <Label Text="{Binding StatusGlyph}" Style="{StaticResource SubtleLabel}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding FavoriteGlyph}" FontSize="20" VerticalOptions="Start">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavoriteTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
