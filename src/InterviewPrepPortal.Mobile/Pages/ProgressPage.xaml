<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InterviewPrepPortal.Mobile.Pages.ProgressPage"
             Title="Progress">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Overall.Mastered}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="Mastered" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Overall.Learning}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="Learning" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Style="{StaticResource CardFrame}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Overall.NotStarted}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="Not started" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Frame Grid.Column="0" Style="{StaticResource CardFrame}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRevisionTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Overall.RevisionNeeded}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="To revise" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="1" Style="{StaticResource CardFrame}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavoritesTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Overall.Favorites}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="Favorites" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Frame>
                    <Frame Grid.Column="2" Style="{StaticResource CardFrame}">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotesTapped" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding NoteCount}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="Notes" Style="{StaticResource SubtleLabel}" />
                        </VerticalStackLayout>
                    </Frame>
                </Grid>

                <Label Text="By category" FontSize="17" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding Categories}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding Category.Name}" FontAttributes="Bold" />
                                        <ProgressBar Progress="{Binding Percent, Converter={StaticResource PercentToFractionConverter}}" ProgressColor="{StaticResource AccentBlue}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding CountLabel}" VerticalOptions="Center" Style="{StaticResource SubtleLabel}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
