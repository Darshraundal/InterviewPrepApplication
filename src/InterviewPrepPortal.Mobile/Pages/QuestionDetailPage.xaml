<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:InterviewPrepPortal.Mobile.ViewModels"
             x:Class="InterviewPrepPortal.Mobile.Pages.QuestionDetailPage"
             Title="{Binding Question.GroupLabel}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding Question.GroupLabel}" Style="{StaticResource SubtleLabel}" />
            <Label Text="{Binding Question.QuestionText}" FontSize="19" FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="10">
                <Label Text="{Binding Question.Difficulty}" Style="{StaticResource SubtleLabel}" />
                <Label Text="{Binding Question.Frequency}" Style="{StaticResource SubtleLabel}" />
            </HorizontalStackLayout>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Answer" FontAttributes="Bold" />
                    <Label Text="{Binding Question.Answer}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding Question.HasExample}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Project example" FontAttributes="Bold" />
                    <Label Text="{Binding Question.ExampleClassName}" Style="{StaticResource SubtleLabel}" />
                    <Label Text="{Binding Question.ExampleMethod}" Style="{StaticResource SubtleLabel}" />
                    <Label Text="{Binding Question.ExampleFile}" Style="{StaticResource SubtleLabel}" />
                    <Label Text="{Binding Question.ExampleCode}" FontFamily="Courier" />
                    <Label Text="{Binding Question.ExampleExplanation}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding Question.Tip, Converter={StaticResource StringNotEmptyConverter}}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Tip" FontAttributes="Bold" />
                    <Label Text="{Binding Question.Tip}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="Follow-ups" FontAttributes="Bold" IsVisible="{Binding Question.FollowUps.Count, Converter={StaticResource CountToVisibleConverter}}" />
            <CollectionView ItemsSource="{Binding Question.FollowUps}" IsVisible="{Binding Question.FollowUps.Count, Converter={StaticResource CountToVisibleConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Question}" FontAttributes="Bold" />
                                <Label Text="{Binding Answer}" IsVisible="{Binding Answer, Converter={StaticResource StringNotEmptyConverter}}" Style="{StaticResource SubtleLabel}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Related questions" FontAttributes="Bold" IsVisible="{Binding CrossReferences.Count, Converter={StaticResource CountToVisibleConverter}}" />
            <CollectionView ItemsSource="{Binding CrossReferences}" IsVisible="{Binding CrossReferences.Count, Converter={StaticResource CountToVisibleConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Style="{StaticResource CardFrame}" Margin="0,4">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCrossReferenceTapped" />
                            </Frame.GestureRecognizers>
                            <Label Text="{Binding Text}" />
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Tracking" FontAttributes="Bold" />

                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Learning" Command="{Binding SetStatusCommand}" CommandParameter="Learning">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsLearning}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentBlue}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Mastered" Command="{Binding SetStatusCommand}" CommandParameter="Mastered">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsMastered}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource AccentBlue}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="Needs revision" Command="{Binding ToggleRevisionCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsRevisionNeeded}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource WarningAmber}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteGlyphConverter}}"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </HorizontalStackLayout>

                    <Label Text="Confidence" Style="{StaticResource SubtleLabel}" />
                    <Picker ItemsSource="{x:Static vm:QuestionDetailViewModel.ConfidenceOptions}"
                            SelectedIndex="{Binding ConfidenceIndex}"
                            SelectedIndexChanged="OnConfidenceChanged" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="My answer" FontAttributes="Bold" />
                    <Editor Text="{Binding CustomAnswerText}" AutoSize="TextChanges" MinimumHeightRequest="100" />
                    <Button Text="Save answer" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCustomAnswerCommand}" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Notes" FontAttributes="Bold" />
                    <Editor Text="{Binding NoteText}" AutoSize="TextChanges" MinimumHeightRequest="80" />
                    <Button Text="Save note" Style="{StaticResource PrimaryButton}" Command="{Binding SaveNoteCommand}" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="{Binding SaveFeedback}" Style="{StaticResource SubtleLabel}" HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="◀ Previous" IsEnabled="{Binding PreviousQuestion, Converter={StaticResource ObjectNotNullConverter}}"
                        Clicked="OnPreviousTapped" />
                <Button Grid.Column="1" Text="Next ▶" IsEnabled="{Binding NextQuestion, Converter={StaticResource ObjectNotNullConverter}}"
                        Clicked="OnNextTapped" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
