<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:InterviewPrepPortal.Mobile.Converters"
             x:Class="InterviewPrepPortal.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:PercentToFractionConverter x:Key="PercentToFractionConverter" />
            <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
            <conv:BoolToFavoriteGlyphConverter x:Key="BoolToFavoriteGlyphConverter" />
            <conv:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <conv:CountToVisibleConverter x:Key="CountToVisibleConverter" />
            <conv:ObjectNotNullConverter x:Key="ObjectNotNullConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
