<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Matches the web app's dark theme palette (wwwroot/css) -->
    <Color x:Key="SurfaceDark">#0F172A</Color>
    <Color x:Key="SurfaceDark2">#1E293B</Color>
    <Color x:Key="SurfaceDark3">#334155</Color>
    <Color x:Key="BorderDark">#334155</Color>
    <Color x:Key="TextPrimary">#F1F5F9</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextTertiary">#64748B</Color>
    <Color x:Key="AccentBlue">#3B82F6</Color>
    <Color x:Key="AccentBlueLight">#60A5FA</Color>
    <Color x:Key="SuccessGreen">#10B981</Color>
    <Color x:Key="WarningAmber">#F59E0B</Color>
    <Color x:Key="DangerRed">#EF4444</Color>
    <Color x:Key="AccentPurple">#8B5CF6</Color>

</ResourceDictionary>
